# 服务器端 PostgreSQL 环境变量
# 用法：cp .env.example .env 后填入真实值；.env 已在 .gitignore 中排除，不会被提交。

# 决定 Compose 项目名，进而决定数据卷名（daoshi_postgres_data）
COMPOSE_PROJECT_NAME=daoshi

# 宿主机映射端口（应用侧连接串要与此一致）
POSTGRES_HOST_PORT=5433

# 数据库凭据
POSTGRES_USER=change_this_postgres_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=change_this_database_name
