# 独立部署 PostgreSQL 的环境变量
# 用法：cp .env.example .env 然后按实际情况修改；.env 已在 .gitignore 中排除，不会被提交。

# 允许连接来源：127.0.0.1 仅本机可连；0.0.0.0 允许外部连接（必须配防火墙/安全组白名单）
INTERNAL_BIND=127.0.0.1

# 宿主机映射端口，按需修改（应用侧连接串要与此一致）
POSTGRES_HOST_PORT=5432

# 数据库凭据
POSTGRES_USER=change_this_postgres_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=change_this_database_name
