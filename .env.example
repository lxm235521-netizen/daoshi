COMPOSE_PROJECT_NAME=manju

# External PostgreSQL server. This Compose file does not start PostgreSQL.
DATABASE_URL=postgresql://username:password@your-postgres-server:5432/manju_community

# Use a long random value in production.
JWT_SECRET=change_this_to_a_long_random_jwt_secret

# External Redis server. This Compose file does not start Redis.
REDIS_URL=redis://:password@your-redis-server:6379
