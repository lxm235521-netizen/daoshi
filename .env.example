COMPOSE_PROJECT_NAME=manju

# Public ports on the deployment server
WEB_PORT=3002
API_PORT=5000
POSTGRES_PORT=5433
REDIS_PORT=6379

# PostgreSQL
POSTGRES_USER=root
POSTGRES_PASSWORD=change_this_database_password
POSTGRES_DB=manju_community

# The hostname is the Compose service name. Do not change postgres to localhost.
DATABASE_URL=postgresql://root:change_this_database_password@postgres:5432/manju_community

# Use a long random value in production.
JWT_SECRET=change_this_to_a_long_random_jwt_secret

# Redis is reserved for later features and is available to the backend container.
REDIS_URL=redis://redis:6379
